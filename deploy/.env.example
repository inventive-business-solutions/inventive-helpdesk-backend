# Portainer stack environment variables for the Inventive Helpdesk backend.
# Set these in the Portainer UI (Stacks -> inventive-helpdesk-backend -> Environment
# variables). Never commit real passwords here.

# ---- Required (always) ----
IMAGE_NAME=ghcr.io/inventive-business-solutions/prod-inventive-helpdesk-backend
# Keep this as "latest". docker stack deploy re-resolves a tag to its current
# registry digest, so redeploying :latest picks up whatever CI last pushed —
# that is what makes the deploy webhook work without the paid "Re-pull image".
# Pinning a SHA here makes every redeploy reinstall that same image forever;
# only set one deliberately, to roll back.
VERSION=latest
BENCH_NAME=inventive_helpdesk_bench

# Traefik host rule. The BACKTICKS ARE PART OF THE VALUE — the compose interpolates
# this straight into Host(...), so without them Traefik parses no rule and returns a
# 404 with its default self-signed certificate. Multiple sites:
#   SITES=`a.example.com`,`b.example.com`
SITES=`helpdeskfrappe.inventivebizsol.co.in`

# The site directory under sites/, used by create-site. No backticks here.
# This is the BACKEND host — the Next.js frontend is deployed separately.
SITE_NAME=helpdeskfrappe.inventivebizsol.co.in

# ---- Deployment control ----
# Steady state. For the FIRST deploy only, flip to CONFIGURE=1, CREATE_SITE=1,
# MIGRATE=0 (see CICD.md), then set them back to these values.
MIGRATE=1
CONFIGURE=0
CREATE_SITE=0
# Clears the shared assets_json redis key after a rollout. Leave at 1 — with it off, a
# deploy can leave the desk rendering against asset hashes that no longer exist on disk.
CLEAR_CACHE=1

# ---- Site creation (first deploy only, with CREATE_SITE=1) ----
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=
INSTALL_APP_ARGS=--install-app inventive_helpdesk_backend

# ---- Database (optional — has defaults) ----
DB_HOST=mariadb_db
DB_PORT=3306

# ---- Optional ----
# Nginx max upload size; ticket attachments larger than this are rejected.
CLIENT_MAX_BODY_SIZE=1024m

# Error reporting. Frappe initialises the Sentry SDK itself when this is set (it ships
# sentry-sdk as a dependency), for the web process, the workers and the scheduler alike.
# Leave EMPTY to disable — both call sites check the variable and return early, so an
# unset DSN initialises nothing rather than failing.
#
# Worth setting on this app specifically: several paths deliberately swallow their
# exception so a mail or audit-log failure cannot roll back the ticket action that
# triggered it (see email._queue_mail, api._send_invite_mail). Those failures are
# currently invisible unless somebody opens the Error Log doctype and looks.
FRAPPE_SENTRY_DSN=

# Optional Sentry tuning, both unset by default. Sampling is fractional (0.0-1.0);
# tracing/profiling every request on a single Swarm node is rarely worth the overhead,
# so start low (e.g. 0.1) if you enable them at all.
# SENTRY_TRACING_SAMPLE_RATE=
# SENTRY_PROFILING_SAMPLE_RATE=
