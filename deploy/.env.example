# Portainer stack environment variables for the Inventive Helpdesk backend.
# Set these in the Portainer UI (Stacks -> inventive-helpdesk-backend -> Environment
# variables). Never commit real passwords here.

# ---- Required (always) ----
IMAGE_NAME=ghcr.io/inventive-business-solutions/prod-inventive-helpdesk-backend
VERSION=latest
BENCH_NAME=inventive_helpdesk_bench

# Traefik host rule. The BACKTICKS ARE PART OF THE VALUE — the compose interpolates
# this straight into Host(...), so without them Traefik parses no rule and returns a
# 404 with its default self-signed certificate. Multiple sites:
#   SITES=`a.example.com`,`b.example.com`
SITES=`helpdeskfrappe.inventivebizsol.co.in`

# The site directory under sites/, used by create-site. No backticks here.
# This is the BACKEND host — the Next.js frontend is deployed separately.
SITE_NAME=helpdeskfrappe.inventivebizsol.co.in

# ---- Deployment control ----
# Steady state. For the FIRST deploy only, flip to CONFIGURE=1, CREATE_SITE=1,
# MIGRATE=0 (see CICD.md), then set them back to these values.
MIGRATE=1
CONFIGURE=0
CREATE_SITE=0

# ---- Site creation (first deploy only, with CREATE_SITE=1) ----
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=
INSTALL_APP_ARGS=--install-app inventive_helpdesk_backend

# ---- Database (optional — has defaults) ----
DB_HOST=mariadb_db
DB_PORT=3306

# ---- Optional ----
# Nginx max upload size; ticket attachments larger than this are rejected.
CLIENT_MAX_BODY_SIZE=1024m
