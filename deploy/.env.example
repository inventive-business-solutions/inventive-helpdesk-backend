# Portainer stack environment variables for the Inventive Helpdesk backend.
# Set these in the Portainer UI (Stacks -> inventive-helpdesk-backend -> Environment
# variables). Never commit real passwords here.

# ---- Required (always) ----
IMAGE_NAME=ghcr.io/inventive-business-solutions/inventive-helpdesk-backend
VERSION=latest
# The Frappe site domain. Traefik routes Host(SITE_NAME) to this stack, and the site
# directory under sites/ must match it exactly. This is the BACKEND host — the Next.js
# frontend lives on helpdesk.inventivebizsol.co.in and is deployed separately.
SITE_NAME=helpdeskfrappe.inventivebizsol.co.in
BENCH_NAME=inventive_helpdesk_dev_bench

# ---- Deployment control ----
# Steady state. For the FIRST deploy only, flip to CONFIGURE=1, CREATE_SITE=1, MIGRATE=0
# (see CICD.md), then set them back to these values.
MIGRATE=1
CONFIGURE=0
CREATE_SITE=0

# ---- Site creation (first deploy only, with CREATE_SITE=1) ----
ADMIN_PASSWORD=
DB_ROOT_PASSWORD=
INSTALL_APP_ARGS=--install-app inventive_helpdesk_backend

# ---- Database (optional — has defaults) ----
DB_HOST=mariadb_db
DB_PORT=3306
